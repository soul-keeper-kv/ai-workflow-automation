{
  "name": "@aap/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Local Fastify API for the AI Automation Platform. Binds to loopback only.",
  "type": "module",
  "scripts": {
    "dev": "AAP_LOG_FORMAT=pretty tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aap/shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "pino-pretty": "^13.1.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
