{
  "name": "ai-automation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "dev": "pnpm build:packages && node scripts/dev.mjs",
    "dev:desktop": "pnpm --filter @aap/desktop tauri dev",
    "build": "pnpm --recursive build",
    "build:desktop": "pnpm --filter @aap/desktop tauri build",
    "typecheck": "pnpm build:packages && pnpm --recursive typecheck",
    "lint": "pnpm build:packages && eslint .",
    "test": "pnpm build:packages && pnpm --recursive test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "prettier": "^3.9.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0",
    "vitest": "catalog:"
  }
}
