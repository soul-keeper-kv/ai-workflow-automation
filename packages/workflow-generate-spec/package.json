{
  "name": "@aap/workflow-generate-spec",
  "version": "0.1.0",
  "private": true,
  "description": "Generate Spec workflow: a reviewed Markdown specification from existing source code.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
